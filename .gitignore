# Secrets — only .env.example is committed.
.env
*.pem
*.key

# Virtualenvs
.venv/
.venv-phoenix/
__pycache__/
*.py[cod]

# Runtime state: databases, traces, workflow history, working copies.
var/
logs/

# Evaluation outputs (regenerated by `make eval`).
evals/logs/
evals/reports/

# Exported evidence bundles (regenerated by `make evidence-bundle`). The frozen
# baseline they embed IS committed, at verification/task-2a-baseline.json.
evidence-bundle/
artifacts/
.promptfoo/
node_modules/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
