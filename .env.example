# Copy to .env and edit. .env is gitignored and must never be committed.
# The entire mock-provider path works with this file exactly as-is: no real
# credentials are required for `make test`, `make eval`, `make demo`, or CI.

# ---------------------------------------------------------------------------
# Local services
# ---------------------------------------------------------------------------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=reliability-walking-skeleton

LITELLM_BASE_URL=http://localhost:4000
# Master key for the local proxy. This is a LOCAL-ONLY placeholder, not a secret:
# the mock provider ignores it entirely. Change it if you expose the proxy.
LITELLM_MASTER_KEY=sk-local-mock-only

PHOENIX_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=reliability-walking-skeleton
# Unset PHOENIX_ENDPOINT to disable export; tracing degrades to a local-only
# no-op exporter and the span ledger still works.

# ---------------------------------------------------------------------------
# Execution
# ---------------------------------------------------------------------------
# temporal | local | auto   (auto = temporal when reachable, else degraded local)
# `local` adds NO retries, timers, persistence, or recovery — see ADR-0006.
EXECUTION_MODE=auto

# Storage root for audit.db, privileged.db, phoenix and temporal data.
VAR_DIR=./var

# Inspect AI sandbox: local | docker
# docker is the stronger boundary and needs a container runtime (ADR-0007).
INSPECT_SANDBOX=local

# ---------------------------------------------------------------------------
# Optional live providers — leave blank for the mock path.
# Setting one adds a model_list entry; no application change is required.
# Never commit real values.
# ---------------------------------------------------------------------------
ENABLE_LIVE_PROVIDERS=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
