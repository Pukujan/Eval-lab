{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Pukujan/Eval-lab/blob/main/schemas/run-telemetry.v1.schema.json",
  "title": "Eval Lab run telemetry record v1",
  "description": "One record per run unit, as written by scripts/run_telemetry.py to telemetry/runs.v1.jsonl. The unique key is run_path. Nullable fields stay null; no metric is coerced to zero. Compute/Colab telemetry is out of scope (see docs/compute/colab-cli.md).",
  "type": "object",
  "required": [
    "schema_version",
    "run_path",
    "scope",
    "experiment",
    "experiment_id",
    "experiment_id_source",
    "run_id",
    "run_id_source",
    "partition",
    "provider",
    "model",
    "has_results",
    "results_sha256",
    "created_at_utc",
    "record_count",
    "resolved_count",
    "status_counts",
    "accuracy",
    "accuracy_ci",
    "accuracy_source",
    "structure",
    "completeness"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_path": {
      "type": "string",
      "pattern": "^experiments/EXP-\\d{8}-\\d{3}-[a-z0-9-]+(/[A-Za-z0-9._-]+)*$",
      "description": "Repo-relative POSIX path of the run directory; the unique key."
    },
    "scope": {"enum": ["experiment", "run", "nested_run", "child_run", "diagnostic"]},
    "experiment": {
      "type": "string",
      "pattern": "^EXP-\\d{8}-\\d{3}-[a-z0-9-]+$",
      "description": "Experiment directory name."
    },
    "experiment_id": {"type": "string", "minLength": 1},
    "experiment_id_source": {"enum": ["embedded", "path"]},
    "run_id": {"type": ["string", "null"]},
    "run_id_source": {"enum": ["embedded", "path", null]},
    "partition": {"type": ["string", "null"]},
    "provider": {"type": ["string", "null"]},
    "model": {"type": ["string", "null"]},
    "has_results": {
      "type": "boolean",
      "description": "True when a results.json exists in the run directory (even if it fails to parse)."
    },
    "results_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "created_at_utc": {
      "type": ["string", "null"],
      "description": "Copied verbatim from results.json; no format is imposed."
    },
    "record_count": {"type": ["integer", "null"], "minimum": 0},
    "resolved_count": {"type": ["integer", "null"], "minimum": 0},
    "status_counts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "accuracy": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "accuracy_ci": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["low", "high"],
          "additionalProperties": false,
          "properties": {
            "low": {"type": ["number", "null"]},
            "high": {"type": ["number", "null"]}
          }
        }
      ]
    },
    "accuracy_source": {
      "enum": ["metrics.accuracy", "aggregate.metrics.accuracy", "accuracy", "correct_count/resolved_count", null],
      "description": "Where accuracy came from, or null when it could not be resolved from a documented location."
    },
    "structure": {
      "type": "object",
      "required": [
        "has_metrics",
        "has_aggregate",
        "has_arms",
        "arms_count",
        "has_arm_accuracy",
        "has_partitions",
        "has_model_arms",
        "has_latency",
        "has_elapsed_seconds",
        "has_cost",
        "has_code_commit"
      ],
      "additionalProperties": false,
      "properties": {
        "has_metrics": {"type": "boolean"},
        "has_aggregate": {"type": "boolean"},
        "has_arms": {"type": "boolean"},
        "arms_count": {"type": ["integer", "null"], "minimum": 0},
        "has_arm_accuracy": {"type": "boolean"},
        "has_partitions": {"type": "boolean"},
        "has_model_arms": {"type": "boolean"},
        "has_latency": {"type": "boolean"},
        "has_elapsed_seconds": {"type": "boolean"},
        "has_cost": {"type": "boolean"},
        "has_code_commit": {"type": "boolean"}
      }
    },
    "completeness": {
      "enum": ["complete", "partial", "quarantined"],
      "description": "complete: results.json parsed; partial: directory present without results.json; quarantined: results.json unparseable or the run was paused/abandoned."
    }
  }
}
